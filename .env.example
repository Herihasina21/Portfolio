# URL publique du site (SEO / Open Graph / sitemap)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.vercel.app

# EmailJS — https://www.emailjs.com/
# 1. Créer un service Gmail connecté à votre boîte
# 2. Créer un template avec Reply To = {{from_email}}
# 3. Variables du template (identiques au formulaire contact) :
#    from_name, from_email, subject, message
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Copier ce fichier en .env.local et remplir les valeurs EmailJS pour tester en local.
# Sur Vercel : Settings → Environment Variables (mêmes 3 clés + NEXT_PUBLIC_SITE_URL).
